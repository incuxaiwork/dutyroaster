generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Officer {
  id           Int     @id @default(autoincrement())
  serialNo     Int
  rank         String
  gno          String  @default("-")
  name         String
  cellNo       String  @default("")
  natureOfDuty String?
  age          Int?
}
